# 복사해서 .env.local 로 저장하세요.

# DB: 로컬/일반 Node 호스팅은 파일 SQLite, Vercel 등 서버리스는 Turso(libsql) 주소 사용
DATABASE_URL=file:./data/mediroad.db
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=

# 세션 서명 키 (운영 환경에서는 반드시 긴 임의 문자열로 교체)
SESSION_SECRET=change-me-to-a-long-random-string

# 관리자 초기 계정 (DB 가 비어 있을 때 한 번만 생성됨. 로그인 후 비밀번호 변경 필수)
ADMIN_ID=admin
ADMIN_PASSWORD=mediroad1234!

# 상담 접수 메일 (비우면 DB 저장만)
MAIL_TO=su6975@naver.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 사이트 주소 (sitemap/OG)
NEXT_PUBLIC_SITE_URL=https://www.mediroad.co.kr
