# 복사해서 .env.local 로 저장하세요. Vercel 에서는 프로젝트 설정 > Environment Variables 에 넣습니다.
# 자세한 설명: docs/Vercel_배포_가이드.md

# 사이트 주소 (sitemap · OG · 비밀번호 재설정 링크)
NEXT_PUBLIC_SITE_URL=https://www.mediroad.co.kr

# 데이터베이스 (Vercel Storage > Postgres 연결 시 자동 추가됨)
# 없으면 데모 모드로 동작합니다: 매물 정보가 공개 데모 8건으로 표시되고 로그인·회원가입은 안내 메시지를 돌려줍니다.
DATABASE_URL=

# 세션 쿠키 서명 키 (openssl rand -hex 32 결과 등 긴 문자열)
AUTH_SECRET=

# 관리자 계정 (첫 배포 때 자동 생성, 이후에는 관리자 권한 유지)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=관리자

# 매물 사진 업로드 (Vercel Storage > Blob 연결 시 자동 추가됨)
BLOB_READ_WRITE_TOKEN=

# 메일 발송 (없으면 서버 로그에만 기록)
RESEND_API_KEY=
NOTIFY_EMAIL=
MAIL_FROM=
