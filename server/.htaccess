# 메디로드 웹사이트 (카페24 웹호스팅)
# Next.js 정적 페이지(out/) + PHP API(api/) + MariaDB
# 페이지 요청(디렉터리·.html·없는 경로)은 router.php 가 로그인·노출 설정을 확인한 뒤 정적 HTML 을 내보낸다.

AddDefaultCharset UTF-8

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 대표 주소 하나로 통일: http·www 없는 주소 → https://www.mediroadmap.com (검색엔진 중복 페이지 방지)
  # 카페24 는 SSL 을 앞단 프록시에서 처리하는 경우가 있어 X-Forwarded-Proto 도 함께 본다.
  # .well-known 은 인증서 발급·갱신용이라 제외한다.
  # 1) www 없는 주소 → www
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTP_HOST} ^mediroadmap\.com$ [NC]
  RewriteRule ^ https://www.mediroadmap.com%{REQUEST_URI} [R=301,L]
  # 2) http → https
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://www.mediroadmap.com%{REQUEST_URI} [R=301,L]

  # 숨김 파일(.env, .git 등) 차단 (.well-known 은 인증서 발급용으로 허용)
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule (^|/)\. - [F,L]

  # PHP 공용 코드·설정, SQL·로그·잠금 파일, 설치용 시드 데이터 차단
  RewriteRule ^app(/|$) - [F,L]
  RewriteRule \.(sql|log|lock|ini|sh|md|bak)$ - [F,L]
  RewriteRule ^install/seed-listings\.json$ - [F,L]

  # 최초 설치 페이지
  RewriteRule ^install/?$ install/index.php [L]

  # 실제 파일(API PHP, _next, 이미지, 폰트, 업로드 사진 등)은 그대로 서빙
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteCond %{REQUEST_URI} !\.html$
  RewriteRule ^ - [L]

  # 나머지(디렉터리, .html, 없는 경로)는 페이지 라우터로
  RewriteRule ^ router.php [L,QSA]
</IfModule>
